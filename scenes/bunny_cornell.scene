# A glass Stanford bunny (69k triangles) in the original Cornell box.
# Needs the mesh: run tools/fetch_models.sh first.
#
# The bunny is centred on the origin, sitting on y = 0, then scaled to about
# 30 cm tall, turned and placed on the floor of the box.

image_width  512
aspect_ratio 1
samples_per_pixel 1024
max_depth    64
background   0 0 0
tonemap      aces
exposure     1

camera lookfrom 278 273 -800  lookat 278 273 0  vup 0 1 0  vfov 39.3

material white lambertian 0.725 0.71 0.68
material red   lambertian 0.63 0.065 0.05
material green lambertian 0.14 0.45 0.091
material light emissive 17 12 4
material glass dielectric 1.5

mesh ../models/cornell_box_empty.obj white
mesh ../models/external/stanford-bunny.obj smooth glass  translate 0.0168 -0.033 0.0015  scale 2000  rotate_y 210  translate 278 0 260
