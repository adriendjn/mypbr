# The Cornell box with a light four times brighter than cornell.scene,
# tonemapped with ACES so the light no longer clips the whole room.

image_width  300
aspect_ratio 1
samples_per_pixel 200
max_depth    50
background   0 0 0
tonemap      aces

camera lookfrom 278 278 -800  lookat 278 278 0  vup 0 1 0  vfov 40

material red   lambertian 0.65 0.05 0.05
material white lambertian 0.73 0.73 0.73
material green lambertian 0.12 0.45 0.15
material light emissive 60 60 60

quad 555 0 0    0 555 0    0 0 555   green   # left wall
quad 0 0 0      0 555 0    0 0 555   red     # right wall
quad 343 554 332  -130 0 0  0 0 -105 light   # ceiling light
quad 0 0 0      555 0 0    0 0 555   white   # floor
quad 555 555 555  -555 0 0  0 0 -555 white   # ceiling
quad 0 0 555    555 0 0    0 555 0   white   # back wall

box 130 0 65   295 165 230  white
box 265 0 295  430 330 460  white
