# A small Cube World-style island loaded from a MagicaVoxel .vox file:
# terrain and three instanced trees placed by the file's scene graph, glass
# water, an emissive lantern and a metal bell (MATL materials).
#
# models/island.vox is generated by tools/make_island_vox.py.

image_width  800
aspect_ratio 16/9
samples_per_pixel 128
max_depth    16

camera lookfrom 70 55 70  lookat 0 6 0  vfov 40
tonemap aces

# MagicaVoxel's three lights: a slightly soft sun, a blue sky filling the
# shadows, and a ground running to the horizon
sun elevation 40 azimuth 120 intensity 3 angle 4
sky uniform 0.35 0.45 0.65
material ground lambertian 0.3 0.3 0.3
ground ground

vox models/island.vox
